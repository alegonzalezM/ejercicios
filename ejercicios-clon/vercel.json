{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/imagenes/(.*)",
      "dest": "/public/imagenes/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.js"
    }
  ]
}

